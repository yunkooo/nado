{
  "name": "@nado/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});\" && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "smoke:backend": "tsx src/backendSmoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "lint": "prettier --check src tsconfig.json package.json"
  },
  "dependencies": {
    "@nado/shared": "workspace:*",
    "@supabase/supabase-js": "^2.110.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
