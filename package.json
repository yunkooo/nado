{
  "name": "nado",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:api": "pnpm --filter @nado/api dev",
    "dev:web": "pnpm --filter @nado/web dev",
    "dev:web:webpack": "pnpm --filter @nado/web dev:webpack",
    "dev:storybook": "pnpm --filter @nado/storybook dev",
    "clean:web-cache": "node scripts/clean-web-dev-cache.mjs",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "pnpm test:workflow && turbo test",
    "test:workflow": "vitest run scripts/notion-ticket-sync.test.mjs",
    "lint": "turbo lint",
    "e2e": "pnpm --filter @nado/e2e e2e",
    "e2e:install": "pnpm --filter @nado/e2e exec playwright install --with-deps chromium",
    "format:check": "prettier --check .",
    "smoke:backend": "pnpm --filter @nado/api smoke:backend",
    "supabase:start": "pnpm exec supabase start",
    "supabase:stop": "pnpm exec supabase stop",
    "supabase:status": "pnpm exec supabase status"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.8.3",
    "supabase": "^2.109.1",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
