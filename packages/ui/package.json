{
  "name": "@nado/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./src/web.ts",
      "development": "./src/web.ts",
      "import": "./dist/web.js"
    },
    "./native": {
      "types": "./src/native.ts",
      "development": "./src/native.ts",
      "import": "./dist/native.js"
    },
    "./web/styles.css": {
      "development": "./src/styles.css",
      "import": "./dist/styles.css"
    },
    "./styles.css": {
      "development": "./src/styles.css",
      "import": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});\" && tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css');\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests --config ../../vitest.config.ts",
    "lint": "prettier --check src tsconfig.json package.json"
  },
  "peerDependencies": {
    "@nado/ui-native": "0.1.0",
    "react": "^19.2.3 || ^19.2.7",
    "react-dom": "^19.2.3 || ^19.2.7"
  },
  "peerDependenciesMeta": {
    "@nado/ui-native": {
      "optional": true
    }
  },
  "dependencies": {
    "@nado/ui-web": "workspace:*"
  },
  "devDependencies": {
    "@nado/ui-native": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
