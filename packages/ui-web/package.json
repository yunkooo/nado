{
  "name": "@nado/ui-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "development": "./src/styles.css",
      "import": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});\" && tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css');\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests --config ../../vitest.config.ts",
    "lint": "prettier --check src tsconfig.json package.json"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "@nado/tokens": "workspace:*"
  },
  "devDependencies": {
    "@nado/shared": "workspace:*",
    "@storybook/react-vite": "^10.4.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
