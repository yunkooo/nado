{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "composite": true,
    "types": ["react", "react-dom"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.stories.tsx", "src/**/*StoryFixtures.ts"]
}
