{
  "name": "@nado/ui-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "lint": "prettier --check src tsconfig.json package.json"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-native": "^0.85.3"
  },
  "dependencies": {
    "@nado/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
